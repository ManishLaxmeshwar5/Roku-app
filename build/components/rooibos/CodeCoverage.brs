' @ignore
function setFilePathMap()
  m.top.filePathMap = {"1":"components/MainScene.brs","2":"components/Models/BookmarkModel.brs","3":"components/Models/MuxModel.brs","4":"components/Models/WatchLaterModel.brs","5":"components/MuxTask.brs","6":"components/ScreenManager.brs","7":"components/TTSTask.brs","8":"components/Toast.brs","9":"components/UIComponents/UICarousel.brs","10":"components/UIComponents/UIHeroPreview.brs","11":"components/UIComponents/UIRowListItem.brs","12":"components/UIComponents/UIShimmerScreen.brs","13":"components/UIComponents/UIrowTitle.brs","14":"components/ViewModel/DetailViewModel.brs","15":"components/ViewModel/HomeScreenViewModel.brs","16":"components/ViewModel/MovieViewModel.brs","17":"components/ViewModel/SearchViewModel.brs","18":"components/ViewModel/SettingsViewModel.brs","19":"components/ViewModel/VideoPlayerViewModel.brs","20":"components/ViewModel/WatchLaterViewModel.brs","21":"components/rooibos/BaseTestReporter.brs","22":"components/rooibos/BaseTestSuite.brs","23":"components/rooibos/CodeCoverageSupport.brs","24":"components/rooibos/CommonUtils.brs","25":"components/rooibos/ConsoleTestReporter.brs","26":"components/rooibos/Coverage.brs","27":"components/rooibos/JUnitTestReporter.brs","28":"components/rooibos/Matchers.brs","29":"components/rooibos/MochaTestReporter.brs","30":"components/rooibos/Rooibos.brs","31":"components/rooibos/RuntimeConfig.brs","32":"components/rooibos/Stats.brs","33":"components/rooibos/Test.brs","34":"components/rooibos/TestGroup.brs","35":"components/rooibos/TestResult.brs","36":"components/rooibos/TestRunner.brs","37":"components/rooibos/Utils.brs","38":"components/rooibos/generated/DetailscreenTests.bs","39":"components/screens/DetailScreen.brs","40":"components/screens/HomeScreen/HomeScreen.brs","41":"components/screens/MovieScreen/MovieScreen.brs","42":"components/screens/SearchScreen/SearchScreen.brs","43":"components/screens/SettingsScreen.brs","44":"components/screens/VideoPlayer.brs","45":"components/screens/WatchLater/WatchlaterScreen.brs","46":"components/sidebar/SideBar.brs","47":"components/sidebar/SideBarItem.brs","48":"components/utils.brs","49":"source/main.brs","50":"components/rooibos/generated/MovieScreenTests.bs","51":"components/rooibos/generated/ToastTests.bs","52":"components/rooibos/generated/watchLaterTests.bs"}
end function

' @ignore
function onEntryChange()
  entry = m.top.entry
  ' defer till later
  m.results.push(entry)
end function

' @ignore
function onSave()
  ? "saving data"
  for each entry in m.results
    if entry <> invalid
      fileId = entry.f
      lineMap = m.resolvedMap[fileId]

      if lineMap = invalid
        lineMap = {}
        m.resolvedMap[fileId] = lineMap
      end if
      lineMap[entry.l] = entry.r
    end if
  end for
  m.top.resolvedMap = m.resolvedMap
  setExpectedMap()
  setFilePathMap()
end function